# Deployment settings and admin login. Add HWIDs and providers through the dashboard.
# Subscription tokens, 2FA enrollment, sessions and application data stay in the persistent Docker volume.
# Required admin login key. Set a long random value before starting the app.
PARSER_ADMIN_TOKEN=
# Set the public address used in client subscription links.
PARSER_PUBLIC_URL=
PARSER_PORT=8099
# Use 0.0.0.0 when Nginx Proxy Manager connects from another host.
PARSER_BIND_ADDRESS=127.0.0.1
# Include the actual proxy address when it runs on another host.
PARSER_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# Concurrent provider downloads (1–32), each with a total deadline (1–120 seconds).
PARSER_FETCH_WORKERS=8
PARSER_FETCH_TIMEOUT_SECONDS=30
# Concurrent client-core checks (1–128); tune against available CPU and RAM.
PARSER_CHECK_WORKERS=8
# Publish/checkpoint between batches (1–300 seconds). Unfinished checks resume automatically.
PARSER_CHECK_BATCH_SECONDS=60
# Opt in to Chrome + X25519-MLKEM768 for generated Mihomo VLESS REALITY configurations.
PARSER_MIHOMO_REALITY_COMPATIBILITY=false
